# PadelHub server-only environment configuration (safe template — never commit real secrets)
#
# All variables are read strictly on the server (src/server/supabase/config.ts).
# Do NOT copy any of these into NEXT_PUBLIC_* variables or client bundles.
# Local, staging, and production must each point to an isolated Supabase project.

# Base HTTPS origin of the target Supabase project (HTTP allowed only for 127.0.0.1 / localhost)
# Local example:   http://127.0.0.1:54321
# Staging example: https://<staging-project-ref>.supabase.co
PADELHUB_SUPABASE_URL=

# Supabase publishable (sb_publishable_...) or legacy anon JWT key for anonymous/session clients.
# Never put a secret or service_role key here; config parsing fails closed if swapped.
PADELHUB_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY privileged Supabase secret (sb_secret_...) or legacy service_role JWT key.
# Used exclusively on the server for private Storage delivery/upload, consented WhatsApp lookup,
# and best-effort analytics recording. Never expose in browser bundles, logs, or NEXT_PUBLIC_*.
PADELHUB_SUPABASE_SERVICE_ROLE_KEY=

# Exact canonical origin of this PadelHub deployment (no trailing slash or path).
# Used for Auth emailRedirectTo callbacks, secure cookie flags, and Origin checks.
# Local example:   http://127.0.0.1:3100
# Staging example: https://<your-staging-origin>
PADELHUB_APP_ORIGIN=
